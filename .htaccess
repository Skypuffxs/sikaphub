<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Disable directory listing globally
    Options -Indexes


    # 2. Block direct access to hidden files (like .env or .git)
    RewriteRule "(^|/)\." - [F,L]

    # 3. Block direct browser access to core application folders
    RewriteRule ^(app|config|routes|views)/ - [F,L]

    # 4. Handle legacy /sikaphub/ prefix gracefully on root hosting (Hostinger)
    RewriteRule ^sikaphub/(.*)$ public/$1 [L,NC]

    # 5. Route all valid web traffic directly into the public/ folder
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L,NC]
</IfModule>

# Security Headers for A+ Grade (SecurityHeaders.com)
<IfModule mod_headers.c>
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), usb=(), display-capture=()"
    Header set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-ancestors 'self';"
</IfModule>