# S.I.K.A.P. Hub — copy to .env and fill in. .env is gitignored.

# Database
DB_HOST=127.0.0.1
DB_NAME=sikaphub_v2_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Application
APP_ENV=development
APP_URL=http://localhost/sikaphub_v2/public

# Matching service (service-to-service). Both values must match the Python
# engine's .env. HMAC_SECRET signs every request body (HMAC-SHA256);
# AI_API_KEY is sent as "Authorization: Bearer <key>".
AI_ENGINE_BASE_URL=http://127.0.0.1:8000
AI_API_KEY=
HMAC_SECRET=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail / SMTP Configuration (Gmail)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=sikaphubinfo@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=sikaphubinfo@gmail.com
MAIL_FROM_NAME="SIKAPHub"
